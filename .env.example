# Local website of make start and make dev; 0 chooses a free port.
PORT=4173
# Optional local model directory; default .models. Never committed.
DEFUSS_MODEL_DIR=.models
# Optional Chromium/Headless Shell executable. Unset uses Playwright's installation.
DEFUSS_CHROMIUM=
# Enable real browser WASM integration in the e2e command.
DEFUSS_LIVE_BROWSER=0
# Optional native ONNX installer configuration (CPU binaries ship in the package).
ONNXRUNTIME_NODE_INSTALL_CUDA=skip
